# Ray BFF 环境变量模板
# 用法：复制为 server/.env（不会入库），或直接注入环境变量。
# 所有键都由 server/src/env.ts 用 zod 校验，缺失时取默认值。

# ---- 服务 ----
RAY_PORT=3000
RAY_HOST=127.0.0.1
RAY_LOG_LEVEL=info

# ---- 数据目录（数据库与上传文件都放这里）----
RAY_DATA_DIR=../data
# RAY_DB_PATH=../data/ray.db

# ---- 主密钥：加密渠道 API Key 用 ----
# 64 位 hex（32 字节）或任意口令（会自动 scrypt 派生）。
# 不填则首次启动自动生成到 <RAY_DATA_DIR>/.master-key。
# 换机器时务必一起迁移，否则已加密的 Key 无法解密。
# RAY_MASTER_KEY=

# ---- 首个管理员（仅当 users 表为空时创建）----
RAY_ADMIN_USER=admin
RAY_ADMIN_PASSWORD=change-me-please

# ---- 会话 Cookie ----
RAY_COOKIE_NAME=ray_session
# 走 Cloudflare / HTTPS 时设为 true
RAY_COOKIE_SECURE=false
RAY_SESSION_DAYS=30

# ---- 限额 ----
RAY_MAX_UPLOAD_MB=64
RAY_USER_DAILY_QUOTA=500

# ---- 单上游快捷配置（渠道表为空时用于快速联调）----
# RAY_UPSTREAM_BASE_URL=https://api.deepseek.com/v1
# RAY_UPSTREAM_API_KEY=sk-xxxxxxxx
# RAY_UPSTREAM_MODEL=deepseek-chat

# ---- 由 BFF 直接托管前端产物（非 Docker 部署默认开启）----
# 设置后访问 http://host:port/ 就是聊天界面；置空则交给前置的 Caddy/Cloudflare。
RAY_WEB_DIR=../dist

# ---- 联网搜索（M3 兜底能力）----
# 指向自建 SearXNG（docker compose 里已带 searxng 服务）。
# 不配置或不可用时，搜索会退化为 DuckDuckGo 抓取；仍然失败则对话照常继续。
# RAY_SEARXNG_URL=http://127.0.0.1:8080

# 读链接时允许抓取的最大正文字节数（默认 2MB）
# RAY_READ_MAX_BYTES=2000000

# 本地关键词审核（英文逗号分隔）。为空表示不拦截，纯透传。
# RAY_MODERATION_KEYWORDS=违禁词1,违禁词2

# 首 token 超时（毫秒，默认 15000）
# 免费中转站排队时间差异很大：实测有的要 8.8 秒，固定 8 秒会把可用上游误判成故障。
# RAY_FIRST_TOKEN_TIMEOUT_MS=15000

# DeepSeek 官方渠道的 BASE URL（OpenAI 兼容接口，不带 /v1）
# RAY_OFFICIAL_BASE_URL=https://api.deepseek.com
